# Copy this file to .env and fill in your values.
# The .env file is git-ignored and must never be committed.

# Your Nostr private key in nsec format (nsec1...) — required by bridge.py
# Generate one at: https://iris.to or https://nostr.com
NOSTR_NSEC=nsec1your_private_key_here

# Your Nostr public key in npub format (npub1...) — used by inspect_nostr.py and scan_nostr.py
# Optional: if not set, the public key is derived from NOSTR_NSEC automatically.
# Setting NOSTR_NPUB lets you run the read-only utility scripts without exposing your private key.
NOSTR_NPUB=npub1your_public_key_here
